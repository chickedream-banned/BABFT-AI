	end
	local function aimRank(part)
		if movingParts[part] then return 0 end
		local name = part.Name:lower()
		if name == "nob" or name == "knob" or name == "lever" or name == "handle" then return 1 end
		if block.Name == "Switch" and part.Parent ~= region and part.Parent.Name == "Switch" then return 2 end
		if name == "rimpart" or name == "ppart" then return 20 end
		return 10
	end
	for _, part in ipairs(descendants) do
		if part:IsA("BasePart") and part.Transparency < 1 then table.insert(parts, part) end
	end
	table.sort(parts, function(a, b) return aimRank(a) < aimRank(b) end)
	local function correctDetector(target)
		if not target or not (target == region or target:IsDescendantOf(region)) then return false end
		local parent = target
		while parent do
			local nearest = parent:FindFirstChildWhichIsA("ClickDetector")
			if nearest then return nearest == detector end
			if parent == region then break end
			parent = parent.Parent
		end
		return false
	end
	local function project(part, space)
		local pixel, visible
		if space == "screen" then pixel, visible = camera:WorldToScreenPoint(part.Position)
		else pixel, visible = camera:WorldToViewportPoint(part.Position) end
		if not visible or pixel.Z <= 0 then return nil end
		local px, py = math.floor(pixel.X + 0.5), math.floor(pixel.Y + 0.5)
		local ray = space == "screen" and camera:ScreenPointToRay(px, py)
			or camera:ViewportPointToRay(px, py)
		local hit = workspace:Raycast(ray.Origin, ray.Direction * 4096, params)
		if hit and correctDetector(hit.Instance) then return { X = px, Y = py }, hit.Instance end
	end
	local space = session.inputProjection or "viewport"
	local point, hitPart, aimPart
	for _, part in ipairs(parts) do
		local projected, hit = project(part, space)
		if projected then point, hitPart, aimPart = projected, hit, part; break end
	end
	assert(point, "Наведи камеру на Switch: видимая точка клика не найдена")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if root then
		local distance = (root.Position - hitPart.Position).Magnitude
		assert(distance <= detector.MaxActivationDistance, "Подойди к Switch: превышена дистанция клика")
	end

	local virtualOk, virtual = pcall(function() return game:GetService("VirtualInputManager") end)
	local nativeMouse = type(mousemoveabs) == "function" and type(mouse1press) == "function"
		and type(mouse1release) == "function"
	local useVirtual = virtualOk and virtual ~= nil
	if mode == "vim" or mode == "touch" then
		assert(useVirtual, "VirtualInputManager недоступен в этой среде")
	elseif mode == "native" then
		assert(nativeMouse, "Нативные mousemoveabs/mouse1press/mouse1release недоступны")
		useVirtual = false
	elseif mode ~= "virtualuser" then
		assert(useVirtual or nativeMouse, "Среда не предоставляет доступный ввод мыши")
	end
	local virtualUser
	if mode == "virtualuser" then virtualUser = game:GetService("VirtualUser") end
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		-- The deletion/build tool must not consume this world click.
		humanoid:UnequipTools()
	end
	local gui = game:GetService("StarterGui")
	local consoleOk, consoleVisible = pcall(function() return gui:GetCore("DevConsoleVisible") end)
	if consoleOk and consoleVisible then
		local closed = pcall(function() gui:SetCore("DevConsoleVisible", false) end)
		assert(closed, "Закрой консоль перед кликом по Switch")
	end
	local cursorOk, oldCursor = pcall(function() return input:GetMouseLocation() end)
	local setupGui, setupVisible = session.setupGui, nil
	if setupGui then
		local setupOk, enabled = pcall(function() return setupGui.Enabled end)
		if setupOk then setupVisible = enabled; setupGui.Enabled = false end
	end
	local x, y = math.floor(point.X), math.floor(point.Y)
	local downOk, downError, upOk, upError
	local attemptOk, attemptError = pcall(function()
		-- Reproject after tool/console changes; errors still run UI cleanup below.
		task.wait(0.1)
		assert(workspace.CurrentCamera == camera, "Камера сменилась перед вводом")
		-- Keep the chosen lever point. Reprojecting the ray-hit part's centre
		-- would replace that point with a potentially different part of the model.
		local currentPoint, currentHit = project(aimPart, space)
		assert(currentPoint, "Точка Switch скрыта или луч попадает в другой детектор")
		x, y, hitPart = currentPoint.X, currentPoint.Y, currentHit
		assert(isCurrentSession(), "Эта версия скрипта остановлена")
		if mode == "touch" then
			local touchesOk, touches = pcall(function() return input:GetTouches() end)
			assert(touchesOk and #touches == 0, "Убери пальцы с экрана перед виртуальным касанием")
			print("GeminiAgent input: backend=VIM-touch x=" .. x .. " y=" .. y)
			downOk, downError = pcall(function()
				virtual:SendTouchEvent(0, Enum.UserInputState.Begin.Value, x, y)
			end)
			if downOk then task.wait(0.12) end
			return
		elseif mode == "virtualuser" then
			virtualUser:CaptureController()
			print("GeminiAgent input: backend=VirtualUser x=" .. x .. " y=" .. y)
			downOk, downError = pcall(function()
				virtualUser:Button1Down(Vector2.new(x, y), camera.CFrame)
			end)
			if downOk then task.wait(0.12) end
			return
		end
		if useVirtual then
			local moved, moveError = pcall(function() virtual:SendMouseMoveEvent(x, y, game) end)
			if not moved and nativeMouse and mode == "mouse" then
				-- No button press has been sent yet, so changing backends is safe.
				useVirtual = false
				mousemoveabs(x, y)
			else
				assert(moved, tostring(moveError))
			end
		else
			mousemoveabs(x, y)
		end
		task.wait(0.1)
		assert(isCurrentSession(), "Эта версия скрипта остановлена")
		local mouseOk, worldMouse = pcall(function() return player:GetMouse() end)
		if mouseOk and worldMouse then
			local targetOk, target = pcall(function() return worldMouse.Target end)
			if not targetOk or not correctDetector(target) then
				-- Moving the pointer does not toggle the switch. Try the other
				-- coordinate convention, then press only on a verified world target.
				local alternative = space == "viewport" and "screen" or "viewport"
				local alternativePoint = project(aimPart, alternative)
				assert(alternativePoint, "Не найдена вторая проекция точки Switch")
				x, y = alternativePoint.X, alternativePoint.Y
				if useVirtual then virtual:SendMouseMoveEvent(x, y, game) else mousemoveabs(x, y) end
				task.wait(0.1)
				assert(isCurrentSession(), "Эта версия скрипта остановлена")
				targetOk, target = pcall(function() return worldMouse.Target end)
				assert(targetOk and correctDetector(target),
					"Указатель не попал на выбранный Switch; нажатие отменено")
				space = alternative
			end
			session.inputProjection = space
			hitPart = target
		end
		print("GeminiAgent mouse: backend=" .. (useVirtual and "VirtualInputManager" or "native")
			.. " space=" .. space .. " x=" .. x .. " y=" .. y
			.. " aim=" .. aimPart:GetFullName() .. " hit=" .. hitPart:GetFullName())
		if useVirtual then
			downOk, downError = pcall(function() virtual:SendMouseButtonEvent(x, y, 0, true, game, 0) end)
		else
			downOk, downError = pcall(mouse1press)
		end
		if downOk then task.wait(0.08) end
	end)
	-- Always release after attempting a press; never retry through another backend.
	if downOk ~= nil then
		if mode == "touch" then
			upOk, upError = pcall(function() virtual:SendTouchEvent(0, Enum.UserInputState.End.Value, x, y) end)
		elseif mode == "virtualuser" then
			upOk, upError = pcall(function() virtualUser:Button1Up(Vector2.new(x, y), camera.CFrame) end)
		elseif useVirtual then
			upOk, upError = pcall(function() virtual:SendMouseButtonEvent(x, y, 0, false, game, 0) end)
		else
			upOk, upError = pcall(mouse1release)
		end
	end
	if cursorOk and oldCursor and mode ~= "touch" and mode ~= "virtualuser" then
		pcall(function()
			if useVirtual then virtual:SendMouseMoveEvent(oldCursor.X, oldCursor.Y, game)
			else mousemoveabs(oldCursor.X, oldCursor.Y) end
		end)
	end
	if consoleOk and consoleVisible then pcall(function() gui:SetCore("DevConsoleVisible", true) end) end
	if setupGui and setupVisible ~= nil then pcall(function() setupGui.Enabled = setupVisible end) end
	assert(attemptOk, tostring(attemptError))
	assert(downOk, tostring(downError))
	assert(upOk, tostring(upError))
end

local function isControlUser(sender)
	local authorized = sender.userId == Players.LocalPlayer.UserId
	for _, userId in ipairs(AUTHORIZED_USER_IDS) do
		if sender.userId == userId then
			authorized = true
		end
	end
	return authorized
end

local function canControl(sender, message)
	return isControlUser(sender) and message:sub(1, #ACTION_PREFIX):lower() == ACTION_PREFIX:lower()
end

local function resolveBuildPath(path)
	local target = buildRoot
	for _, name in ipairs(path) do
		target = target:FindFirstChild(name)
		if not target then
			return nil
		end
	end
	return target
end

local finishBinding -- Assigned after showReply is defined.

local function switchPosition(block)
	-- Prefer a stationary base. The animated Nob is unsuitable as an identity.
	local part = block:FindFirstChild("PPart") or block:FindFirstChild("Part")
	if not part or not part:IsA("BasePart") then
		for _, child in ipairs(block:GetDescendants()) do
			if child:IsA("Motor6D") and child.Part0 then part = child.Part0; break end
		end
	end
	local ok, position = pcall(function() return part and part.Position or block:GetPivot().Position end)
	if ok and position and finite(position.X) and finite(position.Y) and finite(position.Z) then
		return { x = position.X, y = position.Y, z = position.Z }
	end
end

local function positionMatches(record, position)
	return record and position and record.x and
		((record.x - position.x)^2 + (record.y - position.y)^2 + (record.z - position.z)^2)
		<= BIND_POSITION_TOLERANCE^2
end

local function watchSwitch(detector)
	if session.watchedDetectors[detector] then return end
	session.watchedDetectors[detector] = true
	connectOwned(detector.MouseClick, function(player)
		-- Our own input is accounted for by the transition executor.
		if session.dispatchTarget == detector then return end
		forgetPoseState("Ручное нажатие: сначала верни известную позу и выполни !ai sync idle")
		local pending = session.pendingBinding
		if not pending then return end
		if os.clock() > pending.deadline then session.pendingBinding = nil; return end
		if player ~= nil and player ~= Players.LocalPlayer then return end
		if finishBinding then finishBinding(pending, detector) end
	end)
end

local function scanSwitches()
	local groups, candidates = {}, {}
	for _, target in ipairs(buildRoot:GetDescendants()) do
		local block = getBuildBlock(target)
		if target:IsA("ClickDetector") and block.Name == "Switch" then
			groups[block] = groups[block] or {}
			table.insert(groups[block], target)
		end
	end
	for block, detectors in pairs(groups) do
		local direct, directCount = nil, 0
		for _, detector in ipairs(detectors) do
			if detector.Parent == block then direct, directCount = detector, directCount + 1 end
		end
		local selected = directCount == 1 and direct or (#detectors == 1 and detectors[1])
		-- One outer Switch = one number. Never number the inner animated Model.
		if selected then
			table.insert(candidates, { detector = selected, block = block, position = switchPosition(block) })
			watchSwitch(selected)
		end
	end
	table.sort(candidates, function(a, b)
		local pa, pb = a.position, b.position
		if not pa or not pb then return pa ~= nil and pb == nil end
		if pa.x ~= pb.x then return pa.x < pb.x end
		if pa.z ~= pb.z then return pa.z < pb.z end
		return pa.y < pb.y
	end)
	local used, changed = {}, false
	for number, detector in pairs(session.switchRefs) do
		local present = false
		for _, candidate in ipairs(candidates) do if candidate.detector == detector then present = true; break end end
		if present then used[detector] = number
		else session.switchRefs[number] = nil; forgetPoseState("Панель изменилась: проверь привязки и !ai sync idle") end
	end
	-- Across a restart, restore only a unique position match. Missing records
	-- keep their numbers reserved, so later switches cannot silently replace them.
	for numberText, record in pairs(bindingStore.switches) do
		local number = tonumber(numberText)
		if not session.switchRefs[number] then
			local match, count = nil, 0
			for _, candidate in ipairs(candidates) do
				if not used[candidate.detector] and positionMatches(record, candidate.position) then match, count = candidate, count + 1 end
			end
			if count == 1 then
				local competing = 0
				for otherNumber, other in pairs(bindingStore.switches) do
					if not session.switchRefs[tonumber(otherNumber)] and positionMatches(other, match.position) then competing = competing + 1 end
				end
				if competing == 1 then session.switchRefs[number] = match.detector; used[match.detector] = number end
			end
		end
	end
	for _, candidate in ipairs(candidates) do
		if not used[candidate.detector] then
			for number = 1, MAX_ACTUATORS do
				if not bindingStore.switches[tostring(number)] and not session.switchRefs[number] then
					local record = candidate.position or {}
					record.confirmed = false -- Auto numbering is provisional until !ai bind N.
					bindingStore.switches[tostring(number)] = record
					session.switchRefs[number], used[candidate.detector], changed = candidate.detector, number, true
					break
				end
			end
		end
	end
	if changed then saveBindings() end
	return candidates, used
end

local function collectActuators()
	local catalog, registry = {}, {}
	if not findBuildRoot() then return catalog, registry end
	local function add(id, label, target, actions, kind, blockName, number)
		if registry[id] or #catalog >= MAX_ACTUATORS then
			return
		end
		local names = {}
		for action in pairs(actions) do
			if allowedActionNames[action] then
				table.insert(names, action)
			end
		end
		if #names == 0 then
			return
		end
		table.sort(names)
		local block = getBuildBlock(target)
		registry[id] = { target = target, actions = actions, kind = kind, label = label,
			isSwitch = blockName == "Switch", block = block, number = number }
		local record = number and bindingStore.switches[tostring(number)]
		table.insert(catalog, { id = id, label = label, number = number,
			name = block.Name, path = target:GetFullName(), actions = names,
			bound = record and record.confirmed or false,
			estimatedState = number and session.switchStates[number],
			inputMethod = kind == "click" and SWITCH_CLICK_METHOD or "remote",
			learned = session.learned[target] ~= nil,
			interaction = blockName == "Switch" and "toggle_state_unverified" or "click_or_impulse" })
	end
	local switches, switchNumbers = scanSwitches()
	for _, candidate in ipairs(switches) do
		local number = switchNumbers[candidate.detector]
		if number then
			local id = "switch_" .. number
			local record = bindingStore.switches[tostring(number)]
			add(id, record.label or ACTUATOR_LABELS[id] or ("Switch #" .. number), candidate.detector,
				{ activate = true }, "click", "Switch", number)
		end
	end
	for _, config in ipairs(REMOTE_ACTUATORS) do
		local target = resolveBuildPath(config.path)
		if target and target:IsA("RemoteEvent") then
			add(config.id, config.label, target, config.actions, "remote")
		end
	end
	-- A world-input backend can operate detectors even without executor signal helpers.
	if SWITCH_CLICK_METHOD == "learned" or SWITCH_CLICK_METHOD == "mouse" or SWITCH_CLICK_METHOD == "vim"
		or SWITCH_CLICK_METHOD == "touch" or SWITCH_CLICK_METHOD == "virtualuser" or SWITCH_CLICK_METHOD == "native"
		or type(clickObject) == "function" or type(fireMouseSignal) == "function" then
		for _, target in ipairs(buildRoot:GetDescendants()) do
			local block = getBuildBlock(target)
			if target:IsA("ClickDetector") and block.Name ~= "Sign" and block.Name ~= "Switch" then
				if not clickIds[target] then
					nextClickId = nextClickId + 1
					clickIds[target] = "click_" .. nextClickId
				end
				local label = block.Name
				if block ~= target.Parent then
					label = label .. "/" .. target.Parent.Name
				end
				if target.Parent:IsA("BasePart") then
					label = label .. " @ " .. tostring(target.Parent.Position)
				end
				add(clickIds[target], ACTUATOR_LABELS[clickIds[target]] or label, target, { activate = true }, "click", block.Name)
			end
		end
	end
	return catalog, registry
end

local function resolveActuator(name, registry, action)
	if registry[name] then return name, registry[name] end
	if registry["switch_" .. name] then return "switch_" .. name, registry["switch_" .. name] end
	local groups, groupCount, choices = {}, 0, {}
	for id, entry in pairs(registry) do
		if (entry.block.Name:lower() == name:lower() or entry.label:lower() == name:lower()) and entry.actions[action] ~= nil then
			if not groups[entry.block] then
				groups[entry.block] = {}
				groupCount = groupCount + 1
			end
			table.insert(groups[entry.block], { id = id, entry = entry })
			table.insert(choices, id)
		end
	end
	if groupCount == 1 then
		local candidates = select(2, next(groups))
		local direct, directCount = nil, 0
		for _, candidate in ipairs(candidates) do
			if candidate.entry.kind == "click" and candidate.entry.target.Parent == candidate.entry.block then
				direct, directCount = candidate, directCount + 1
			end
		end
		if directCount == 1 then return direct.id, direct.entry end
		if #candidates == 1 then return candidates[1].id, candidates[1].entry end
	end
	if #choices > 0 then
		table.sort(choices)
		return nil, nil, "Имя " .. name .. " неоднозначно. Выбери ID: " .. table.concat(choices, ", ")
	end
	if name:lower() == "gate" then
		return nil, nil, "Gate получает сигнал: выбери подключённый Switch или другой источник"
	end
	return nil, nil, "Для " .. name .. " нет доступного действия " .. action .. ". Проверь !ai list"
end

local function printActuators()
	local catalog = collectActuators()
	print("GeminiAgent catalog: " .. HttpService:JSONEncode(catalog))
	local count = 0
	for _, entry in ipairs(catalog) do
		if entry.number then
			count = count + 1
			print("GeminiRobot switch #" .. entry.number .. " " .. entry.label .. " bound=" .. tostring(entry.bound)
				.. " state=" .. tostring(session.switchStates[entry.number]))
		end
	end
	print("GeminiRobot switches=" .. count .. "; count outer models, NOT ControllerId or inner Switch")
	for _, target in ipairs(buildRoot:GetDescendants()) do
		if target:IsA("RemoteEvent") or target:IsA("RemoteFunction") then
			print("GeminiAgent event: " .. target.ClassName .. " " .. target:GetFullName())
		elseif (target.Name == "ControllerRef" or target.Name == "ControllerRefTemplate"
			or target.Name == "ControllerId") and target:IsA("ValueBase") then
			local ok, value = pcall(function()
				return target.Value
			end)
			if ok then
				local description = typeof(value) == "Instance" and value:GetFullName() or tostring(value)
				print("GeminiAgent controller: " .. target:GetFullName() .. " ["
					.. target.ClassName .. "] = " .. description)
			end
		end
	end
end

local function observeActivation(entry)
	local observation = { inputBegan = 0, inputEnded = 0, detectorEvents = 0,
		observedChange = false, gateChange = false, fields = 0, connections = {} }
	local before = switchSnapshot(entry.block)
	local gateBefore = {}
	for _, object in ipairs(buildRoot:GetDescendants()) do
		if object.Name == "ControllerRef" and object:IsA("ObjectValue") then
			local source = object.Value
			if typeof(source) == "Instance" and (source == entry.block or source:IsDescendantOf(entry.block)) then
				local gate = getBuildBlock(object)
				local on = gate.Name == "Gate" and gate:FindFirstChild("On")
				if on and on:IsA("BoolValue") then gateBefore[on] = on.Value end
			end
		end
	end
	for _ in pairs(before) do observation.fields = observation.fields + 1 end
	function observation.sample()
		if observation.closed then return end
		local after = switchSnapshot(entry.block)
		for object, value in pairs(before) do
			if after[object] ~= nil and after[object] ~= value then observation.observedChange = true end
		end
		for on, value in pairs(gateBefore) do
			if on.Parent and on.Value ~= value then observation.gateChange = true end
		end
	end
	local function watch(signal, callback)
		local connection = connectOwned(signal, callback)
		table.insert(observation.connections, connection)
	end
	local function inputEvent(event, processed, field)
		local kind = event.UserInputType
		if kind == Enum.UserInputType.MouseButton1 or kind == Enum.UserInputType.Touch then
			observation[field] = observation[field] + 1
			observation.processedByUI = observation.processedByUI or processed == true
		end
	end
	local input = game:GetService("UserInputService")
	if input.InputBegan then watch(input.InputBegan, function(event, processed) inputEvent(event, processed, "inputBegan") end) end
	if input.InputEnded then watch(input.InputEnded, function(event, processed) inputEvent(event, processed, "inputEnded") end) end
	watch(entry.target.MouseClick, function(player)
		if player == nil or player == Players.LocalPlayer then
			observation.detectorEvents = observation.detectorEvents + 1
		end
	end)
	for object in pairs(before) do
		if object.Changed then watch(object.Changed, observation.sample) end
	end
	for on in pairs(gateBefore) do
		if on.Changed then watch(on.Changed, observation.sample) end
	end
	local heartbeatOk, heartbeat = pcall(function() return game:GetService("RunService").Heartbeat end)
	if heartbeatOk and heartbeat then watch(heartbeat, observation.sample) end
	function observation.close()
		if observation.closed then return end
		observation.sample()
		observation.closed = true
		for _, connection in ipairs(observation.connections) do
			pcall(function() connection:Disconnect() end)
			for index = #session.connections, 1, -1 do
				if session.connections[index] == connection then table.remove(session.connections, index); break end
			end
		end
	end
	return observation
end

local function executeAction(command, registry, methodOverride, poseStep)
	if not isCurrentSession() then return { ok = false, detail = "Эта версия скрипта остановлена" } end
	if session.recording then return { ok = false, detail = "Сейчас идёт запись ручного нажатия. Подожди её завершения" } end
	if session.pendingBinding then return { ok = false, detail = "Сначала закончи привязку номера или !ai bind cancel" } end
	if session.controlBusy or (session.poseBusy and not poseStep) then
		return { ok = false, detail = "Уже меняю позу. Подожди немного" }
	end
	if type(command) ~= "table" or type(command.target) ~= "string"
		or not allowedActionNames[command.action] then
		return { ok = false, detail = "Некорректная команда ИИ" }
	end
	local resolvedId, entry, resolveError = resolveActuator(command.target, registry, command.action)
	if not entry or entry.actions[command.action] == nil then
		return { ok = false, detail = resolveError or "Объект или действие отсутствует в каталоге" }
	end
	if entry.number and session.switchRefs[entry.number] ~= entry.target then
		return { ok = false, detail = "Нумерация изменилась после команды. Повтори просьбу" }
	end
	if not poseStep then forgetPoseState("Отдельное нажатие: восстанови известную позу и выполни !ai sync idle") end
	session.controlBusy, session.dispatchTarget = true, entry.target
	local method, listeners, observedChange, observedFields, observation
	local ok, failure = pcall(function()
		assert(entry.target:IsDescendantOf(buildRoot), "Объект удалён из постройки")
		if entry.kind == "click" then
			listeners = mouseListenerCount(entry.target)
			method = methodOverride or SWITCH_CLICK_METHOD
			if method == "auto" then
				method = type(fireMouseSignal) == "function" and listeners and listeners > 0
					and "signal" or "click"
			end
			assert(method == "click" or method == "signal" or method == "mouse" or method == "learned"
				or method == "vim" or method == "touch" or method == "virtualuser" or method == "native",
				"Неизвестный метод активации")
			local block = getBuildBlock(entry.target)
			print("GeminiAgent dispatch: " .. entry.target:GetFullName() .. " method=" .. method
				.. " localListeners=" .. tostring(listeners)
				.. " maxDistance=" .. tostring(entry.target.MaxActivationDistance))
			observation = observeActivation(entry)
			-- Send exactly one event. Never retry a toggle automatically.
			if method == "learned" then
				local learned = session.learned[entry.target]
				assert(learned and learned.block == block,
					"Сначала запиши ручное переключение: !ai learn " .. resolvedId)
				local call = learned.call
				assert(call.remote.Parent ~= nil, "Записанный объект события удалён")
				local args = copyRecorded(call.args, {}, 0, { count = 0 })
				if call.method == "FireServer" then
					call.remote:FireServer(table.unpack(args, 1, args.n))
				else
					call.remote:InvokeServer(table.unpack(args, 1, args.n))
				end
			elseif method == "mouse" or method == "vim" or method == "touch"
				or method == "virtualuser" or method == "native" then
				sendWorldClick(entry.target, method)
			elseif method == "signal" then
				assert(type(fireMouseSignal) == "function", "Среда не предоставляет firesignal")
				fireMouseSignal(entry.target.MouseClick, Players.LocalPlayer)
			else
				assert(type(clickObject) == "function", "Среда не предоставляет fireclickdetector")
				clickObject(entry.target, 0, "MouseClick")
			end
			for _ = 1, 10 do
				if not isCurrentSession() then break end
				task.wait(0.1)
				observation.sample()
			end
		else
			local args = entry.actions[command.action]
			entry.target:FireServer(table.unpack(args, 1, args.n or #args))
		end
	end)
	if observation then
		observation.close()
		observedFields = observation.fields
		if observedFields > 0 then observedChange = observation.observedChange end
	end
	session.controlBusy, session.dispatchTarget = false, nil
	return { ok = ok, target = resolvedId, name = entry.block.Name, action = command.action,
		isSwitch = entry.isSwitch,
		method = method, localListeners = listeners, observedChange = observedChange,
		observedFields = observedFields,
		inputBegan = observation and observation.inputBegan,
		inputEnded = observation and observation.inputEnded,
		detectorEvents = observation and observation.detectorEvents,
		processedByUI = observation and observation.processedByUI,
		gateChange = observation and observation.gateChange,
		detail = ok and (observedChange and "Наблюдается изменение на клиенте; сервер не проверен"
			or "Вызов выполнен; изменение объекта не подтверждено") or redact(failure) }
end

local function validatePose(id, registry, requireState)
	local pose = ROBOT_POSES[id]
	if type(pose) ~= "table" or type(pose.switches) ~= "table" then return nil, "Такой позы нет. Проверь !ai poses" end
	local steps = {}
	for number, desired in pairs(pose.switches) do
		if not validNumber(number) or type(desired) ~= "boolean" then return nil, "Ошибка маски позы " .. id end
		local entry = registry["switch_" .. number]
		local record = bindingStore.switches[tostring(number)]
		if not entry or not entry.number or not record or not record.confirmed
			or session.switchRefs[number] ~= entry.target then
			return nil, "Сначала привяжи свитч: !ai bind " .. number
		end
		if requireState and type(session.switchStates[number]) ~= "boolean" then
			return nil, session.stateReason or "Состояние неизвестно. Выставь вручную idle, затем !ai sync idle"
		end
		table.insert(steps, { number = number, desired = desired, entry = entry })
	end
	if #steps == 0 then return nil, "У позы нет свитчей" end
	table.sort(steps, function(a, b) return a.number < b.number end)
	return steps, nil, pose
end

local function poseCatalog(registry)
	local poses = {}
	for id, pose in pairs(ROBOT_POSES) do
		local steps, reason = validatePose(id, registry, true)
		table.insert(poses, { id = id, label = type(pose) == "table" and pose.label or id, ready = steps ~= nil,
			expresses = type(pose) == "table" and pose.expresses or nil,
			reason = reason, current = session.currentPose == id })
	end
	table.sort(poses, function(a, b) return a.id < b.id end)
	return poses
end

local function executePose(id, registry)
	if not isCurrentSession() then return { ok = false, action = "pose", detail = "Эта версия остановлена" } end
	session.pendingPose = nil
	if session.poseBusy or session.controlBusy or session.recording or session.pendingBinding then
		return { ok = false, action = "pose", detail = "Подожди окончания текущего действия или настройки" }
	end
	local steps, reason, pose = validatePose(id, registry, true)
	if not steps then return { ok = false, action = "pose", target = id, detail = reason } end
	local changes = {}
	for _, step in ipairs(steps) do
		if session.switchStates[step.number] ~= step.desired then table.insert(changes, step) end
	end
	if #changes > MAX_POSE_SWITCHES then return { ok = false, action = "pose", detail = "Слишком много изменений в одной позе" } end
	if #changes == 0 then
		session.currentPose = id
		if session.refreshSetup then session.refreshSetup() end
		return { ok = true, action = "pose", target = id, pose = pose.label or id,
			already = true, steps = {}, detail = "По учёту эта поза уже выставлена; повторного клика нет" }
	end
	session.poseBusy = true
	local revision, results = session.stateRevision, {}
	local ok, failure = pcall(function()
		-- Break old signals before making new ones; transitions are sequential,
		-- so every intermediate combination must also be safe for this build.
		table.sort(changes, function(a, b)
			if a.desired ~= b.desired then return not a.desired end
			return a.number < b.number
		end)
		for _, step in ipairs(changes) do
			assert(isCurrentSession(), "Эта версия остановлена")
			assert(revision == session.stateRevision, "Во время перехода было ручное нажатие. Нужна синхронизация")
			local result = executeAction({ target = "switch_" .. step.number, action = "activate" }, registry, nil, true)
			table.insert(results, result)
			assert(result.ok and (result.observedChange == true or result.gateChange == true),
				"Свитч " .. step.number .. ": " .. (result.detail or "Нет реакции"))
			assert(revision == session.stateRevision, "Состояние изменилось вручную. Нужна синхронизация")
			-- This is an estimate from the known baseline plus observed toggles,
			-- not a server-side read of the Switch's ON/OFF state.
			session.switchStates[step.number] = step.desired
			task.wait(POSE_CLICK_INTERVAL)
		end
		assert(isCurrentSession() and revision == session.stateRevision, "Состояние изменилось во время перехода")
	end)
	session.poseBusy = false
	if not ok then
		forgetPoseState("Переход прерван. Выставь известную позу вручную, затем !ai sync idle")
		return { ok = false, action = "pose", target = id, steps = results, detail = redact(failure) }
	end
	session.currentPose = id
	if session.refreshSetup then session.refreshSetup() end
	return { ok = true, action = "pose", target = id, pose = pose.label or id,
		observedChange = true, estimated = true, steps = results, detail = "Все нужные свитчи отреагировали на клиенте; поза рассчитана от ручной синхронизации" }
end

local function executeBotCommand(command, registry, permissions)
	if type(command) ~= "table" or type(command.action) ~= "string" or type(command.target) ~= "string" then
		return { ok = false, detail = "Некорректная команда ИИ" }
	end
	if permissions.revision ~= session.stateRevision then
		return { ok = false, detail = "Во время ответа изменилось состояние или привязки. Повтори просьбу" }
	end
	if command.action == "pose" then
		if not permissions.poses then return { ok = false, detail = "Позы не разрешены для этого сообщения" } end
		local now = os.clock()
		if session.lastAutomaticPoseAt and now - session.lastAutomaticPoseAt < POSE_COOLDOWN then
			return { ok = true, action = "pose", target = command.target, skipped = true,
				detail = "Жест пропущен: разговор продолжается, тело пока сохраняет позу" }
		end
		local input = game:GetService("UserInputService")
		if input:GetFocusedTextBox() then
			-- Never steal focus from an ongoing conversation. Keep the reply
			-- immediate; perform this gesture after the player closes the input.
			session.pendingPose = { target = command.target, revision = session.stateRevision, expires = now + 20 }
			return { ok = true, action = "pose", target = command.target, skipped = true, deferred = true,
				detail = "Жест отложен до закрытия поля ввода; разговор продолжается" }
		end
		local result = executePose(command.target, registry)
		if result.ok and not result.already then session.lastAutomaticPoseAt = os.clock() end
		return result
	end
	if not permissions.raw then return { ok = false, detail = "Отдельные свитчи доступны только владельцу и доверенным игрокам" } end
	return executeAction(command, registry)
end

local function resumePendingPose()
	local pending = session.pendingPose
	if not pending then return end
	if not isCurrentSession() or not AUTO_POSES or os.clock() > pending.expires
		or pending.revision ~= session.stateRevision then session.pendingPose = nil; return end
	if session.poseBusy or session.controlBusy or session.pendingBinding or session.recording
		or game:GetService("UserInputService"):GetFocusedTextBox() then return end
	session.pendingPose = nil
	local _, registry = collectActuators()
	if pending.revision ~= session.stateRevision then return end
	local result = executePose(pending.target, registry)
	if result.ok and not result.already then session.lastAutomaticPoseAt = os.clock() end
	print("GeminiRobot deferred pose: " .. HttpService:JSONEncode(result))
end

local function getSender(player, userId)
	return {
		username = player and player.Name or ("User" .. tostring(userId)),
		displayName = player and player.DisplayName or "",
		userId = userId,
	}
end

local function generateReply(sender, message, feedback, chatOnly)
	local catalog, registry, poses, bodyReady = {}, {}, {}, false
	local bodyOk, bodyFailure = pcall(function()
		catalog, registry = collectActuators()
		poses = poseCatalog(registry)
	end)
	if not bodyOk then
		catalog, registry, poses = {}, {}, {}
		warn("GeminiRobot body: " .. redact(bodyFailure) .. "; продолжаю общение без движений")
	end
	for _, pose in ipairs(poses) do if pose.ready then bodyReady = true; break end end
	local coolingDown = session.lastAutomaticPoseAt ~= nil and os.clock() - session.lastAutomaticPoseAt < POSE_COOLDOWN
	local permissions = { raw = not chatOnly and feedback == nil and bodyOk and canControl(sender, message),
		poses = not chatOnly and feedback == nil and AUTO_POSES and bodyReady and not coolingDown
			and not session.pendingBinding and not session.poseBusy and not session.controlBusy and not session.recording
			and (ALLOW_PUBLIC_POSES or isControlUser(sender)) }
	local actionsAllowed = permissions.raw or permissions.poses
	permissions.revision = session.stateRevision
	-- Encode identity separately from text so message text cannot change the
	-- sender fields. UserId identifies a player even when DisplayNames match.
	local userTurn = {
		role = "user",
		parts = {{ text = HttpService:JSONEncode({
			username = sender.username,
			displayName = sender.displayName,
			userId = sender.userId,
			message = message,
			actionsAllowed = actionsAllowed,
			rawActionsAllowed = permissions.raw,
			posesAllowed = permissions.poses,
			bodyReady = bodyReady,
