-- Direct startup: no loadstring, downloads or embedded API key.
local enteredKey
local loaderGui, loaderLabel
local startupStage = "Проверка клиентской среды"

local function showStartupFailure(failure)
    local message = tostring(failure)
    if enteredKey and enteredKey ~= "" then
        while true do
            local first, last = message:find(enteredKey, 1, true)
            if not first then break end
            message = message:sub(1, first - 1) .. "[API_KEY]" .. message:sub(last + 1)
        end
    end
    message = startupStage .. ": " .. message
    pcall(function()
        if not loaderLabel or not loaderLabel.Parent then
            local player = game:GetService("Players").LocalPlayer
            local parent = player and player:FindFirstChildOfClass("PlayerGui")
            if not parent then return end
            loaderGui = Instance.new("ScreenGui")
            loaderGui.Name, loaderGui.ResetOnSpawn, loaderGui.DisplayOrder = "BabftGeminiLoader", false, 1003
            loaderLabel = Instance.new("TextLabel")
            loaderLabel.Size, loaderLabel.Position = UDim2.new(0, 360, 0, 160), UDim2.new(0, 20, 0, 70)
            loaderLabel.TextColor3, loaderLabel.TextSize, loaderLabel.TextWrapped = Color3.fromRGB(255, 255, 255), 16, true
            loaderLabel.Parent, loaderGui.Parent = loaderGui, parent
        end
        loaderGui.DisplayOrder = 1003
        loaderLabel.BackgroundColor3 = Color3.fromRGB(120, 35, 35)
        loaderLabel.Text = "ИИ не запустился:\n" .. message:sub(1, 700)
    end)
    if type(warn) == "function" then warn("BABFT_STARTUP: " .. message)
    elseif type(print) == "function" then print("BABFT_STARTUP: " .. message) end
end

