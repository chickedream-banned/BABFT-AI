local function switchSnapshot(block)
	local values = {}
	for _, object in ipairs(block:GetDescendants()) do
		if object:IsA("BoolValue") then
			values[object] = tostring(object.Value)
		elseif object:IsA("BasePart") and object.CFrame ~= nil then
			values[object] = tostring(object.CFrame)
		elseif object:IsA("Motor6D") then
			values[object] = tostring(object.Transform) .. ":" .. tostring(object.C0) .. ":" .. tostring(object.C1)
		elseif object:IsA("Beam") then
			values[object] = tostring(object.Enabled)
		elseif object:IsA("Sound") then
			values[object] = tostring(object.Playing)
		end
	end
	return values
end

local function snapshotChanged(before, block)
	local after, count, changed = switchSnapshot(block), 0, false
	for object, value in pairs(before) do
		count = count + 1
		if after[object] ~= nil and after[object] ~= value then changed = true end
	end
	return changed, count
end

-- A recording never guesses a remote or its arguments. Only calls referencing
-- the selected source (or a remote inside it) can be recorded. Native server
-- ClickDetector handling has no Lua FireServer call and cannot be learned here.
local function referencesBlock(value, block, seen, depth)
	if typeof(value) == "Instance" then
		return value == block or value:IsDescendantOf(block)
	end
	if type(value) ~= "table" or depth > 8 or seen[value] then return false end
	seen[value] = true
	for key, child in pairs(value) do
		if referencesBlock(key, block, seen, depth + 1)
			or referencesBlock(child, block, seen, depth + 1) then return true end
	end
	return false
end

local function copyRecorded(value, seen, depth, budget)
	if typeof(value) == "Instance" then return value end
	if type(value) ~= "table" then return value end
	if seen[value] then return seen[value] end
	assert(depth <= 8, "Слишком глубокие аргументы")
	local copy = {}
	seen[value] = copy
	for key, child in pairs(value) do
		budget.count = budget.count + 1
		assert(budget.count <= 500, "Слишком большие аргументы")
		copy[copyRecorded(key, seen, depth + 1, budget)] = copyRecorded(child, seen, depth + 1, budget)
	end
	return copy
end

local function installRecorder()
	assert(type(hookmetamethod) == "function" and type(getnamecallmethod) == "function",
		"Среда не предоставляет hookmetamethod/getnamecallmethod для записи реального вызова")
	local state = sessionScope.__BabftGeminiCallRecorder
	if type(state) ~= "table" then
		state = {}
		local original
		local function hook(remote, ...)
			local method = getnamecallmethod()
			local args = table.pack(...)
			-- Recording errors must never interrupt the game's original call.
			pcall(function()
				local owner = sessionScope.__BabftGeminiSignSession
				local recording = owner and owner.active and owner.recording
				if not recording or recording.busy or os.clock() > recording.deadline then return end
				if type(checkcaller) == "function" and checkcaller() then return end
				if method ~= "FireServer" and method ~= "InvokeServer" then return end
				if typeof(remote) ~= "Instance" then return end
				if not ((method == "FireServer" and remote:IsA("RemoteEvent"))
					or (method == "InvokeServer" and remote:IsA("RemoteFunction"))) then return end
				recording.busy = true
				local ok, failure = pcall(function()
					local associated = false
					for block in pairs(recording.sources) do
						if remote:IsDescendantOf(block) or referencesBlock(args, block, {}, 0) then
							associated = true; break
						end
					end
					if not associated then return end
					if #recording.calls >= 10 then recording.overflow = true; return end
					local copied = copyRecorded(args, {}, 0, { count = 0 })
					table.insert(recording.calls, { remote = remote, method = method, args = copied })
				end)
				recording.busy = false
				if not ok then recording.failure = tostring(failure) end
			end)
			return original(remote, table.unpack(args, 1, args.n))
		end
		original = hookmetamethod(game, "__namecall", type(newcclosure) == "function" and newcclosure(hook) or hook)
		state.installed = true
		sessionScope.__BabftGeminiCallRecorder = state
	end
end

