local function requestGemini(options)
	local complete, result = false, nil
	options.Timeout = 25
	task.spawn(function()
		result = table.pack(pcall(sendHttp, options))
		complete = true
	end)
	local deadline = os.clock() + 30
	while not complete do
		if not isCurrentSession() then error("Эта версия скрипта остановлена", 0) end
		if os.clock() >= deadline then error("Gemini не ответил за 30 секунд. Проверь соединение", 0) end
		task.wait(0.1)
	end
	if not result[1] then error(redact(result[2]), 0) end
	assert(type(result[2]) == "table", "HTTP-функция не вернула ответ")
	return result[2]
end

